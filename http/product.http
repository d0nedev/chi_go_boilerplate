@baseUrl = http://localhost:8080/api/v1
@apiKey = change-me
@productId = 6517d82c-0154-45c8-ab79-52271e0e181

### List Products (first page)
GET {{baseUrl}}/products?limit=20

### List Products (next page, use next_cursor from previous response)
GET {{baseUrl}}/products?limit=20&cursor=REPLACE_WITH_NEXT_CURSOR

### Find Product by ID
GET {{baseUrl}}/products/{{productId}}

### Create Product
POST {{baseUrl}}/products
Content-Type: application/json
X-API-Key: {{apiKey}}

{
    "name": "Iphone 17 pro",
    "price": "12300000.00"
}

### Update Product
PUT {{baseUrl}}/products/{{productId}}
Content-Type: application/json
X-API-Key: {{apiKey}}

{
    "name": "MacBook Pro M5",
    "price": "27000000.00"
}

### Delete Product
DELETE {{baseUrl}}/products/{{productId}}
X-API-Key: {{apiKey}}
